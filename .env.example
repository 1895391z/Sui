# 国内大模型（OpenAI-compatible Chat Completions）
# DeepSeek 示例：https://api.deepseek.com
# 阿里云百炼示例：https://dashscope.aliyuncs.com/compatible-mode/v1
HYSYS_LLM_API_KEY=请填写你的API密钥
HYSYS_LLM_BASE_URL=https://api.deepseek.com
HYSYS_LLM_MODEL=deepseek-v4-flash
HYSYS_LLM_TIMEOUT=60

# 可选：HYSYS 注册表不可用时显式指定安装路径
# HYSYS_EXE_PATH=C:\Program Files\AspenTech\Aspen HYSYS V15\HYSYS.exe
